{{!
    @template core/check/summary_bar

    Summary bar showing a count box for each check result status present on the page.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * items - array of status summary items, each with:
      * count     - integer count of results with this status
      * label     - localised status label eg "OK", "Warning"
      * bgcolor   - Bootstrap background class eg "bg-success"
      * textcolor - Bootstrap text class eg "text-white"

    Example context (json):
    {
        "items": [
            {"count": 2, "label": "Error",   "bgcolor": "bg-danger",  "textcolor": "text-white"},
            {"count": 1, "label": "Warning", "bgcolor": "bg-warning", "textcolor": "text-dark"},
            {"count": 65, "label": "OK",     "bgcolor": "bg-success", "textcolor": "text-white"}
        ]
    }
}}
<div class="d-flex flex-wrap gap-2 mb-4" data-region="check-summary-bar">
    {{#items}}
    <div class="card {{bgcolor}} {{textcolor}} text-center px-3 py-2" style="min-width: 7em;">
        <div class="fs-3 fw-bold lh-1">{{count}}</div>
        <div class="small text-uppercase text-nowrap">{{label}}</div>
    </div>
    {{/items}}
</div>
